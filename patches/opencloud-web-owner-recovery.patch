+import { useThemeStore, AuthStore, ConfigStore, UserStore } from '@opencloud-eu/web-pkg'
+
+// An explicit, local recovery authority. This small gate supplies an in-memory
+// bearer to the original Files application; it is not an OIDC/account emulator.
+const initializeOwnerRecovery = async (
+  config: ConfigStore, auth: AuthStore, user: UserStore
+) => {
+  if (config.options.volparossaOwnerRecovery !== true) return
+  const origin = window.location.origin
+  if (window.location.protocol !== 'http:' || window.location.hostname !== '127.0.0.1'
+      || new URL(config.serverUrl).origin !== origin
+      || config.apps.length !== 1 || config.apps[0] !== 'files'
+      || config.externalApps.length || config.scripts.length || config.styles.length
+      || config.customTranslations.length) {
+    throw new Error('Owner recovery requires an isolated loopback Files application')
+  }
+  const panel = document.createElement('section')
+  panel.id = 'volparossa-owner-recovery'
+  panel.setAttribute('aria-label', 'VOLPAROSSA private recovery')
+  panel.style.cssText = 'max-width:36rem;margin:5rem auto;padding:2rem;position:relative;z-index:2;background:Canvas;color:CanvasText'
+  const heading = document.createElement('h1')
+  heading.textContent = 'Private recovery · OpenCloud Files'
+  const explanation = document.createElement('p')
+  explanation.textContent = 'Read selected private files through your local VOLPAROSSA service. This is not an OpenCloud account login and does not grant sharing or write access.'
+  const form = document.createElement('form')
+  const label = document.createElement('label')
+  label.textContent = 'Local recovery access token'
+  const input = document.createElement('input')
+  input.id = 'volparossa-recovery-token'
+  input.type = 'password'
+  input.autocomplete = 'off'
+  input.maxLength = 8192
+  input.required = true
+  input.style.cssText = 'display:block;width:100%;margin:1rem 0'
+  label.htmlFor = input.id
+  const button = document.createElement('button')
+  button.type = 'submit'
+  button.textContent = 'Open private files'
+  const status = document.createElement('p')
+  status.setAttribute('role', 'status')
+  form.append(label, input, button, status)
+  panel.append(heading, explanation, form)
+  document.body.append(panel)
+  document.getElementById('splash-loading')?.classList.add('splash-hide')
+  input.focus()
+  await new Promise<void>((resolve) => {
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault()
+      if (button.disabled) return
+      button.disabled = true
+      const token = input.value
+      input.value = ''
+      try {
+        if (!/^[A-Za-z0-9._~+/-]{32,8192}=*$/.test(token)) throw new Error('Invalid token')
+        const response = await fetch(origin + '/volparossa/recovery/session', {
+          headers: { Authorization: `Bearer ${token}` }, cache: 'no-store',
+          credentials: 'omit', redirect: 'error', signal: AbortSignal.timeout(10000)
+        })
+        if (!response.ok) throw new Error('Access refused')
+        const session = await response.json()
+        if (session.version !== 1 || session.authority !== 'owner-local-catalog'
+            || session.readOnly !== true || session.upstreamAccount !== false
+            || session.owner?.id !== 'volparossa-owner-recovery'
+            || session.owner?.displayName !== 'Private recovery') throw new Error('Wrong authority')
+        user.setUser({ id: session.owner.id, displayName: session.owner.displayName })
+        auth.setAccessToken(token)
+        auth.setUserContextReady(true)
+        panel.remove()
+        if (!window.location.hash || window.location.hash === '#/') {
+          window.history.replaceState(null, '', '#/files/spaces/projects')
+        }
+        resolve()
+      } catch {
+        // Never include tokens, response bodies, paths or error objects in logs.
+        status.textContent = 'Local recovery access failed. Check the service and token.'
+        button.disabled = false
+        input.focus()
+      }
+    })
+  })
+}
 
